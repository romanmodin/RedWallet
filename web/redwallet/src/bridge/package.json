{
  "name": "@caffeine/redwallet-fulcrum-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone HTTPS-to-Fulcrum bridge for RedWallet. Read-only, operator-configured, authenticated.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.8.3"
  }
}
