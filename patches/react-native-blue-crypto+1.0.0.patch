+// Fixed-cost storage derivation. Never resolve uninitialized bytes after failure.
+RCT_REMAP_METHOD(scryptSecure, scryptSecure:(NSArray *)pw
+                 salt:(NSArray *)salt
+                 resolver:(RCTPromiseResolveBlock)resolve
+                 rejecter:(RCTPromiseRejectBlock)reject)
+{
+    const size_t passLen = [pw count];
+    if (passLen == 0 || passLen > 65536 || [salt count] != 16) {
+        reject(@"SCRYPT_INPUT", @"Invalid storage key input", nil);
+        return;
+    }
+    uint8_t *password = malloc(passLen);
+    uint8_t *saltBytes = malloc(16);
+    uint8_t key[32] = {0};
+    @try {
+        if (!password || !saltBytes) {
+            reject(@"SCRYPT_FAILED", @"Storage key derivation failed", nil);
+            return;
+        }
+        for (size_t i = 0; i < passLen; i++) password[i] = [[pw objectAtIndex:i] unsignedCharValue];
+        for (size_t i = 0; i < 16; i++) saltBytes[i] = [[salt objectAtIndex:i] unsignedCharValue];
+        if (libscrypt_scrypt(password, passLen, saltBytes, 16, 32768, 8, 3, key, 32) != 0) {
+            reject(@"SCRYPT_FAILED", @"Storage key derivation failed", nil);
+            return;
+        }
+        NSMutableString *result = [NSMutableString stringWithCapacity:64];
+        for (size_t i = 0; i < 32; i++) [result appendFormat:@"%02x", key[i]];
+        resolve(result);
+    } @catch (NSException *ignored) {
+        reject(@"SCRYPT_FAILED", @"Storage key derivation failed", nil);
+    } @finally {
+        // Volatile stores prevent the compiler from removing the wipe.
+        volatile uint8_t *wipeKey = key;
+        for (size_t i = 0; i < 32; i++) wipeKey[i] = 0;
+        if (password) {
+            volatile uint8_t *wipePassword = password;
+            for (size_t i = 0; i < passLen; i++) wipePassword[i] = 0;
+            free(password);
+        }
+        if (saltBytes) {
+            volatile uint8_t *wipeSalt = saltBytes;
+            for (size_t i = 0; i < 16; i++) wipeSalt[i] = 0;
+            free(saltBytes);
+        }
+    }
 }
 
